# Ask the user to enter employee details
name = input("Enter employee name: ")
basic_salary = float(input("Enter basic salary: "))
deduction = float(input("Enter monthly deduction: "))

# Calculate housing allowance
allowance = 0.10 * basic_salary

# Calculate gross salary
gross_salary = basic_salary + allowance

# Calculate net salary
net_salary = gross_salary - deduction

# Display employee salary details
print("\n--- Employee Salary Details ---")
print("Employee Name:", name)
print("Basic Salary:", basic_salary)
print("Housing Allowance:", allowance)
print("Gross Salary:", gross_salary)
print("Monthly Deduction:", deduction)
print("Net Salary:", net_salary)
