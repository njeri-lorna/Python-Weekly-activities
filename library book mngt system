class Book:
 def__init__(self,title,author,price,copies):
  self.title = title
  self.author = author
  self.price = price
  self.copies = copies

 def calculate_stock_value(self):
  return self.price*self.copies

 def check_stock(self):
  if self.copies>0:
   return"In stock"
  else:
   return"out of stock"

