"""
This program stores and displays employee information.
It also demonstrates the use of Boolean values and
converting a number to a string using str().
"""

# Create and assign employee information
employee_name = "Lorna Njeri"
employee_age = 30
employee_salary = 50000.00
employee_active = True

# Display employee information using f-strings
print("Employee Information")
print(f"Employee Name: {employee_name}")
print(f"Employee Age: {employee_age}")
print(f"Employee Salary: {employee_salary:.2f}")
print(f"Employee Active: {employee_active}")

# Demonstrate converting a number to a string before concatenation
age_message = "Employee age is " + str(employee_age)
print(age_message)
